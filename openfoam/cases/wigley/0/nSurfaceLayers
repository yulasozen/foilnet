FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      nSurfaceLayers;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    symmetry
    {
        type            symmetryPlane;
    }
    farfield
    {
        type            fixedValue;
        value           uniform 0;
    }
    hull
    {
        type            fixedValue;
        value           uniform 1;
    }
}


